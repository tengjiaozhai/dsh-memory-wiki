{
  "name": "dsh-workbuddy-plus",
  "displayName": "DSH WorkBuddy Plus",
  "version": "0.8.0",
  "description": "WorkBuddy 桌面 App 模型接入 DSH：dsh-workbuddy-connect@0.7.9 的规则化移植（适配 dsh 0.2.1-rc.2 / rc.3），并把 dsh-workbuddy-brandfix 的品牌令牌改写合并进同一个插件。",
  "author": "shenmingjie",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./client": "./lib/connect/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./connect": "./lib/connect/index.js"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "scripts",
    "LICENSE.upstream-dsh-workbuddy-connect",
    "THIRD_PARTY_NOTICES.txt"
  ],
  "dependencies": {
    "@earendil-works/pi-ai": "1.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-attachment": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.1-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.5",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "bin": {
    "dsh-workbuddy-connect": "./lib/connect/bin.js",
    "dsh-workbuddy-plus": "./lib/connect/bin.js"
  },
  "scripts": {
    "vendor": "node scripts/vendor-upstream.mjs",
    "test": "node test/smoke.mjs",
    "test:accounts": "node test/accounts.mjs",
    "test:credits": "node test/credits.mjs"
  }
}
